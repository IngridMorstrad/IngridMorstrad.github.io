{{- /* Atom feed for list pages (sections, taxonomies): e.g. /posts/atom.xml */ -}}
{{- $atom := .OutputFormats.Get "ATOM" -}}
{{- $pages := first 20 (.RegularPages.ByDate.Reverse) -}}
{{- $updated := .Lastmod -}}
{{- with index $pages 0 -}}
  {{- $updated = .Lastmod -}}
{{- end -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ if .Title }}{{ printf "%s on %s" .Title .Site.Title | htmlEscape }}{{ else }}{{ .Site.Title | htmlEscape }}{{ end }}</title>
  <id>{{ .Permalink }}</id>
  <updated>{{ $updated.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <link rel="alternate" type="text/html" href="{{ .Permalink }}" />
  {{- with $atom -}}
  <link rel="self" type="{{ .MediaType.Type }}" href="{{ .Permalink }}" />
  {{- end -}}
  <generator>Hugo</generator>

  {{- range $pages -}}
  <entry>
    <title>{{ .Title | htmlEscape }}</title>
    <link rel="alternate" type="text/html" href="{{ .Permalink }}" />
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <summary type="html">{{ .Summary | htmlEscape }}</summary>
    <content type="html">{{ .Content | htmlEscape }}</content>
  </entry>
  {{- end -}}
</feed>


